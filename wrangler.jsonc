{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framebooks",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXTAUTH_URL": "https://books.frametoque.com"
  }
}
