# ========================================================
# Framebooks Environment Variables Template (.env.example)
# All sensitive variables are SERVER-ONLY and must never
# be prefixed with NEXT_PUBLIC_.
# ========================================================

# [SERVER ONLY] PostgreSQL Connection String (Pooler or direct SSL connection)
DATABASE_URL="postgresql://postgres:password@localhost:5432/framebooks?sslmode=require"

# [SERVER ONLY] NextAuth Authentication Configuration
NEXTAUTH_URL="https://framebooks.lk"
NEXTAUTH_SECRET="secure-random-32-byte-secret-hex-or-base64"

# [SERVER ONLY] Optional dedicated admin session secret (defaults to NEXTAUTH_SECRET)
ADMIN_AUTH_SECRET="dedicated-admin-random-32-byte-secret"

# [SERVER ONLY] Google OAuth Provider Credentials
GOOGLE_CLIENT_ID="sample-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sample-client-secret"

# [SERVER ONLY] Cloudflare R2 Object Storage (receipts, slips, logos, assets)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="framebooks-uploads"
R2_PUBLIC_URL="https://pub-sample.r2.dev"

# [PUBLIC] Application Base URL for client links and OG metadata
NEXT_PUBLIC_APP_URL="https://framebooks.lk"

# [SERVER ONLY] Optional: Apple Wallet Passes Integration
APPLE_PASS_TYPE_ID="pass.lk.framebooks.invoice"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_CERT_P12_BASE64=""
APPLE_CERT_P12_PASSWORD=""

# [SERVER ONLY] Optional: Google Wallet Passes Integration
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLIENT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""
WALLET_ASSET_BASE_URL="https://framebooks.lk"

# [SERVER ONLY] SMTP Email Delivery (for App Lock OTP verification and alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="security@framebooks.lk"
SMTP_PASS="your-app-password-or-smtp-key"
SMTP_FROM="\"Framebooks\" <framebooks@frametoque.com>"
SMTP_REPLY_TO="framebooks@frametoque.com"
