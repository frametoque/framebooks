# ========================================================
# Framebooks Environment Variables Template (.env.example)
# All sensitive variables are SERVER-ONLY and must never
# be prefixed with NEXT_PUBLIC_.
# ========================================================

# [SERVER ONLY] PostgreSQL Connection String (Pooler or direct SSL connection)
DATABASE_URL="postgresql://postgres:password@localhost:5432/framebooks?sslmode=require"

# [SERVER ONLY] NextAuth Authentication Configuration
NEXTAUTH_URL="https://books.frametoque.com"
NEXTAUTH_SECRET="secure-random-32-byte-secret-hex-or-base64"

# [SERVER ONLY] Master Encryption Key (32 bytes hex for AES-256-GCM envelope encryption)
APP_MASTER_KEY="your-32-byte-hex-master-encryption-key-do-not-lose"

# [SERVER ONLY] Optional: Dedicated Blind Index HMAC key (defaults to HKDF derivation from APP_MASTER_KEY)
# BLIND_INDEX_KEY="your-32-byte-hex-blind-index-key"

# [SERVER ONLY] Optional dedicated admin session secret (defaults to NEXTAUTH_SECRET)
ADMIN_AUTH_SECRET="dedicated-admin-random-32-byte-secret"

# [SERVER ONLY] Google OAuth Provider Credentials
GOOGLE_CLIENT_ID="sample-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sample-client-secret"

# [SERVER ONLY] Cloudflare R2 Object Storage (receipts, slips, logos, assets)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="framebooks-uploads"
R2_PUBLIC_URL="https://pub-sample.r2.dev"
# [SERVER ONLY] Optional: Custom S3 API endpoint URL for R2 / MinIO (defaults to Cloudflare standard)
# R2_S3_API="https://<account-id>.r2.cloudflarestorage.com"

# [PUBLIC] Application Base URL for client links and OG metadata
NEXT_PUBLIC_APP_URL="https://books.frametoque.com"

# ========================================================
# Payments.lk Gateway Configuration (PRIMARY)
# Docs: https://payments.lk/developers
# Dashboard: https://app.payments.lk/admin/developers
# ========================================================
# [SERVER ONLY] Environment: "sandbox" | "production" (defaults to production if sk_live_ configured)
PAYMENTS_LK_ENV="sandbox"
PAYMENTS_LK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYMENTS_LK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYMENTS_LK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ========================================================
# Optional Secondary Gateways (Stripe / PayHere)
# ========================================================
# Active Provider override: "payments_lk" | "stripe" | "payhere" (default: payments_lk)
PAYMENT_GATEWAY_PROVIDER="payments_lk"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_ENV="sandbox"


# [SERVER ONLY] Optional: Apple Wallet Passes Integration
APPLE_PASS_TYPE_ID="pass.com.frametoque.books.invoice"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_CERT_P12_BASE64=""
APPLE_CERT_P12_PASSWORD=""

# [SERVER ONLY] Optional: Google Wallet Passes Integration
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLIENT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""
WALLET_ASSET_BASE_URL="https://books.frametoque.com"

# [SERVER ONLY] Cron Trigger Secret (Required for /api/payments/cron/renewals)
CRON_SECRET="your-secure-random-cron-secret-32-bytes"

# [SERVER ONLY] SMTP Email Delivery (for App Lock OTP verification and alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="security@frametoque.com"
SMTP_PASS="your-app-password-or-smtp-key"
SMTP_FROM="\"Framebooks\" <framebooks@frametoque.com>"
SMTP_REPLY_TO="framebooks@frametoque.com"
